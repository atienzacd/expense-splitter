# Copy this file to .env (in this folder) and adjust as needed.
DATABASE_URL=postgresql://splitter:splitter@localhost:5432/splitter
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Generate your own: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=replace-me-with-a-random-value-of-32-characters-or-more
JWT_EXPIRES_IN=1d
# Set to true only behind a reverse proxy you control (it trusts X-Forwarded-For).
TRUST_PROXY=false
