# Copy this file to .env (in this folder) and adjust as needed.
DATABASE_URL=postgresql://splitter:splitter@localhost:5432/splitter
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Required: replace with your own random value. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=replace-me-with-a-random-value-of-32-characters-or-more
JWT_EXPIRES_IN=1d
# IP addresses (or CIDR ranges) of the reverse proxy in front of the app, e.g. 10.0.0.0/8,
# or "loopback" for a proxy on the same machine.
# Leave false when clients connect directly. "true" is rejected: clients could fake their IP.
TRUST_PROXY=false
