# Copy this file to .env (in this folder) and adjust as needed.
DATABASE_URL=postgresql://splitter:splitter@localhost:5432/splitter
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Required: replace with your own random value. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=replace-me-with-a-random-value-of-32-characters-or-more
# How long an access token lasts (at most 1h); the browser renews it automatically.
ACCESS_TOKEN_TTL=15m
# How long a login lasts on one device without being used (at most 90d).
REFRESH_TOKEN_TTL=14d
# Websites allowed to make changes through the API (comma-separated origins).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Login cookies over HTTPS only. Browsers accept this on http://localhost too.
COOKIE_SECURE=true
# IP addresses (or CIDR ranges) of the reverse proxy in front of the app, e.g. 10.0.0.0/8,
# or "loopback" for a proxy on the same machine.
# Leave false when clients connect directly. "true" is rejected: clients could fake their IP.
TRUST_PROXY=false
