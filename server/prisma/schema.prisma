// Database schema. Money columns are whole centavos (Int), never floats.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum SplitType {
  EQUAL
  EXACT
  PERCENTAGE
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  groupsCreated       Group[]        @relation("GroupCreatedBy")
  memberships         GroupMember[]
  expensesPaid        Expense[]      @relation("ExpensePaidBy")
  splits              ExpenseSplit[]
  settlementsPaid     Settlement[]   @relation("SettlementFrom")
  settlementsReceived Settlement[]   @relation("SettlementTo")
  sessions            Session[]
  invitationsSent     Invitation[]   @relation("InvitationsSent")

  @@map("users")
}

// One row per login on one device. The refresh token itself is never stored,
// only its SHA-256 hash, so a database leak doesn't hand out live sessions.
model Session {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  // Set when the token is swapped for a new one, or on logout.
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Group {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  createdBy   User          @relation("GroupCreatedBy", fields: [createdById], references: [id])
  members     GroupMember[]
  expenses    Expense[]
  settlements Settlement[]
  invitations Invitation[]

  @@map("groups")
}

// A pending invitation to join a group. It's addressed to an email, not an
// account, so inviting someone reveals nothing about whether they're
// registered, and friends can be invited before they sign up. Accepting or
// declining deletes the row; the security log keeps the history.
model Invitation {
  id          String   @id @default(uuid(7)) @db.Uuid
  groupId     String   @map("group_id") @db.Uuid
  email       String
  invitedById String   @map("invited_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  invitedBy User  @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([groupId, email])
  @@index([email])
  @@map("invitations")
}

model GroupMember {
  groupId  String   @map("group_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@id([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

model Expense {
  id          String    @id @default(uuid(7)) @db.Uuid
  groupId     String    @map("group_id") @db.Uuid
  paidById    String    @map("paid_by_id") @db.Uuid
  description String
  amount      Int
  splitType   SplitType @map("split_type")
  createdAt   DateTime  @default(now()) @map("created_at")

  group  Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidBy User           @relation("ExpensePaidBy", fields: [paidById], references: [id])
  splits ExpenseSplit[]

  @@index([groupId, createdAt])
  @@map("expenses")
}

model ExpenseSplit {
  expenseId  String @map("expense_id") @db.Uuid
  userId     String @map("user_id") @db.Uuid
  amountOwed Int    @map("amount_owed")

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@id([expenseId, userId])
  @@map("expense_splits")
}

model Settlement {
  id         String   @id @default(uuid(7)) @db.Uuid
  groupId    String   @map("group_id") @db.Uuid
  fromUserId String   @map("from_user_id") @db.Uuid
  toUserId   String   @map("to_user_id") @db.Uuid
  amount     Int
  createdAt  DateTime @default(now()) @map("created_at")

  group    Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromUser User  @relation("SettlementFrom", fields: [fromUserId], references: [id])
  toUser   User  @relation("SettlementTo", fields: [toUserId], references: [id])

  @@index([groupId, createdAt])
  @@map("settlements")
}
